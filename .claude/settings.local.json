{
  "permissions": {
    "allow": [
      "Bash(chmod:*)",
      "Bash(nix develop:*)",
      "WebFetch(domain:sailboatdata.com)",
      "Bash(curl:*)",
      "Bash(git add:*)",
      "Bash(python sailboat_compare.py:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(git checkout:*)",
      "Bash(gh repo set-default:*)",
      "Bash(gh api:*)",
      "Bash(git commit:*)",
      "Bash(gh pr merge:*)",
      "Bash(git pull:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue reopen:*)",
      "Bash(black:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit:*.py",
        "hooks": [
          {
            "type": "command",
            "command": "black -t py313 \"${file_path}\""
          }
        ]
      },
      {
        "matcher": "Write:*.py",
        "hooks": [
          {
            "type": "command",
            "command": "black -t py313 \"${file_path}\""
          }
        ]
      }
    ]
  }
}
